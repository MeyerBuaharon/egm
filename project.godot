config_version=5

[application]
config/name="Underfoot — Warden Lab"
run/main_scene="res://forest_slice.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.11, 1)

[physics]
common/physics_ticks_per_second=120
